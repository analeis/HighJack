{
  "name": "highjack",
  "version": "0.2.12",
  "private": true,
  "description": "HighJack- a browser-first multiplayer board/economy game built around a configurable ruleset and deterministic simulation.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun run --filter='@highjack/web' dev",
    "dev:game": "bun run --filter='@highjack/game' dev",
    "dev:server": "./scripts/dev-server.sh",
    "build": "bun run build:web && bun run build:game && ./scripts/build-server.sh",
    "build:web": "bun run --filter='@highjack/web' build",
    "build:game": "bun run --filter='@highjack/game' build",
    "test": "bun run --filter='./packages/*' --filter='./apps/game' --filter='./apps/web' test && bun run test:go",
    "test:go": "go test -count=1 -race ./server/...",
    "test:e2e": "bun run --filter='@highjack/web' test:e2e",
    "lint": "oxlint packages apps scripts && go vet ./...",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run typecheck:ts && bun run typecheck:reference && bun run typecheck:astro",
    "typecheck:ts": "bun check -p tsconfig.json",
    "typecheck:reference": "bunx tsc6 --noEmit -p tsconfig.json",
    "typecheck:astro": "bun run --filter='@highjack/web' check",
    "validate": "bun scripts/validate.ts",
    "gate": "bun scripts/gate.ts",
    "certify": "bun scripts/certify.ts"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "bun-types": "1.4.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "playwright-core": "^1.64.1"
  }
}
