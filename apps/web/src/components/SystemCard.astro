---
// One system tile. Status badges are explicit: Modeled / In development /
// Planned — the site never implies shipped gameplay.
import { Badge } from '@highjack/ui';
import { statusLabel, type GameSystem } from '../data/systems';

interface Props {
  system: GameSystem;
}
const { system } = Astro.props;
---

<article
  class="group flex h-full flex-col gap-3 rounded-lg border border-line-subtle bg-surface-raised p-5 shadow-card transition-all duration-normal ease-out-hj hover:-translate-y-0.5 hover:border-line-strong"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="m-0 font-display text-lg font-bold text-cream-100">{system.name}</h3>
    <Badge
      tone={system.status === 'modeled'
        ? 'teal'
        : system.status === 'in-development'
          ? 'gold'
          : 'neutral'}
    >
      {statusLabel(system.status)}
    </Badge>
  </div>
  <p class="m-0 font-mono text-xs uppercase tracking-widest text-gold-500/90">{system.tagline}</p>
  <p class="m-0 text-sm leading-relaxed text-muted-400">{system.description}</p>
</article>
