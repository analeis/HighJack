---
// One system tile. Status is shown in a plain label and a left rule, so it is
// readable without relying on the badge colour.
import { Badge } from '@highjack/ui';
import { statusLabel, type GameSystem } from '../data/systems';

interface Props {
  system: GameSystem;
}
const { system } = Astro.props;

const tone = system.status === 'playable' ? 'gold' : system.status === 'modeled' ? 'teal' : 'neutral';
---

<article
  class:list={[
    'flex h-full flex-col gap-3 border-l-2 bg-surface-raised/60 p-5',
    system.status === 'playable' ? 'border-l-gold-500' : 'border-l-line-strong',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="m-0 font-display text-lg font-semibold text-cream-100">{system.name}</h3>
    <Badge tone={tone}>{statusLabel(system.status)}</Badge>
  </div>
  <p class="m-0 text-xs text-muted-400">{system.tagline}</p>
  <p class="m-0 text-sm leading-relaxed text-muted-400">{system.description}</p>
</article>
