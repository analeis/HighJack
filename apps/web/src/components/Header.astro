---
// Site header: wordmark, four primary destinations, source link.
// Desktop links are static Astro output so navigation works without JavaScript.
// The mobile drawer is a Solid island receiving the same item list.
import Logo from './Logo.astro';
import { MobileNav } from '../islands/MobileNav';

const items = [
  { href: '/game', label: 'Game' },
  { href: '/features', label: 'Features' },
  { href: '/rules', label: 'Rules' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-line-subtle bg-felt-950/90 backdrop-blur">
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8"
  >
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="HighJack home">
      <Logo class="h-8 w-8" />
      <span class="font-display text-lg font-semibold tracking-tight text-cream-100">
        High<span class="text-gold-500">Jack</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class:list={[
                  'relative block py-1 text-sm no-underline transition-colors duration-fast',
                  currentPath === item.href
                    ? 'text-cream-100 after:absolute after:-bottom-1 after:left-0 after:h-px after:w-full after:bg-gold-500'
                    : 'text-muted-400 hover:text-cream-100',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/analeis/highjack"
        class="hidden text-sm text-muted-400 no-underline transition-colors hover:text-cream-100 md:block"
      >
        Source
      </a>
      <MobileNav client:visible items={items} currentPath={currentPath} />
    </div>
  </div>
</header>
