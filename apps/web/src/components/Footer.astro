---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line-subtle">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-5 py-10 sm:px-8 md:flex-row md:items-center md:justify-between"
  >
    <div class="flex items-center gap-3">
      <Logo class="h-7 w-7" />
      <div>
        <p class="m-0 font-display text-sm font-semibold text-cream-100">HighJack</p>
        <p class="m-0 text-xs text-muted-500">A playable board loop, built in the open.</p>
      </div>
    </div>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-xs">
        <li><a class="text-muted-400 no-underline hover:text-cream-100" href="/features">Features</a></li>
        <li><a class="text-muted-400 no-underline hover:text-cream-100" href="/rules">Rules</a></li>
        <li><a class="text-muted-400 no-underline hover:text-cream-100" href="/changelog">Changelog</a></li>
        <li><a class="text-muted-400 no-underline hover:text-cream-100" href="/about">About</a></li>
        <li>
          <a
            class="text-muted-400 no-underline hover:text-cream-100"
            href="https://github.com/analeis/highjack"
          >
            Source
          </a>
        </li>
      </ul>
    </nav>

    <p class="m-0 text-xs text-muted-500">© {year} HighJack contributors · MIT</p>
  </div>
</footer>
