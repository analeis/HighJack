---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line-subtle bg-felt-950/70">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center">
    <div class="flex items-center gap-3">
      <Logo class="h-8 w-8" />
      <div>
        <p class="m-0 font-display font-extrabold text-cream-100">HighJack</p>
        <p class="m-0 text-xs text-muted-500">
          A configurable board/economy game — in development.
        </p>
      </div>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <li>
          <a class="text-muted-400 no-underline hover:text-gold-400" href="/features">
            Features
          </a>
        </li>
        <li>
          <a class="text-muted-400 no-underline hover:text-gold-400" href="/rules">
            Rules
          </a>
        </li>
        <li>
          <a class="text-muted-400 no-underline hover:text-gold-400" href="/changelog">
            Changelog
          </a>
        </li>
        <li>
          <a class="text-muted-400 no-underline hover:text-gold-400" href="/about">
            About
          </a>
        </li>
        <li>
          <a
            class="text-muted-400 no-underline hover:text-gold-400"
            href="https://github.com/analeis/highjack"
          >
            Source
          </a>
        </li>
      </ul>
    </nav>
    <p class="m-0 text-xs text-muted-500">© {year} HighJack contributors · MIT</p>
  </div>
</footer>
