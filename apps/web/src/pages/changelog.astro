---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Badge } from '@highjack/ui';

interface Entry {
  version: string;
  date: string;
  title: string;
  status: 'released' | 'in-development';
  highlights: { label: string; tone: 'teal' | 'gold' | 'neutral'; items: string[] }[];
}

// Changelog entries, newest first. Keep in sync with git tags.
const entries: Entry[] = [
  {
    version: '0.2.2',
    date: '2026-09-26',
    title: 'Multiplayer integrity and durability',
    status: 'released',
    highlights: [
      {
        label: 'Seats and authorization',
        tone: 'gold',
        items: [
          'Claiming a seat is refused on the socket. It previously minted a player with no reconnect token that could never be bound or removed, while consuming a seat — repeating it filled the match permanently',
          'A seat claim is now a real transition: state, events, snapshot and the player row commit in one transaction, and it is published to the table immediately',
          'A seat claim that cannot be committed consumes nothing, so an interrupted request no longer leaves a seat nothing can release',
        ],
      },
      {
        label: 'Delivery and recovery',
        tone: 'teal',
        items: [
          'A transition is delivered as one batched frame, so two transitions can no longer interleave on a single connection and leave a peer with the wrong turn and the wrong ownership',
          'A new connection receives nothing until its snapshot has been written, so it can never apply a transition the snapshot does not contain',
          'A commit that reports an error is reconciled against the stored state instead of being rolled back in memory. The old behaviour left memory a tick behind, and every later action then failed on a duplicate key, bricking the match',
          'Migrations are applied at boot and readiness checks the schema, so a server can no longer report itself ready against a database it cannot write to',
          'The server keeps idle connections alive, which it advertised but never did: an idle lobby or a long think used to be disconnected after 90 seconds',
        ],
      },
      {
        label: 'Hardening',
        tone: 'teal',
        items: [
          'Live matches and rate-limiter keys are both bounded and swept, closing an unauthenticated path to unbounded memory',
          'Outside development, an unconfigured origin allow-list now refuses browser origins instead of accepting any',
          'The match seed is no longer broadcast to clients; it stays in the durable event payload for replay',
          'Reconnect tokens are compared in constant time',
        ],
      },
    ],
  },
  {
    version: '0.2.1',
    date: '2026-09-26',
    title: 'Stabilization — evidence and engine correctness',
    status: 'released',
    highlights: [
      {
        label: 'Certification integrity',
        tone: 'gold',
        items: [
          'The certification report now identifies the tested tree, not just the last commit, and refuses to certify a dirty tree',
          'A skipped mandatory gate fails certification; optional gates are recorded as skipped, never as passed',
          'Dependency audit, Go vulnerability scan and the race detector are now certification gates, not CI-only steps',
          'CI invokes the same shared gate list instead of restating the commands, and the database gate no longer filters out the tests it exists to run',
        ],
      },
      {
        label: 'Verification coverage',
        tone: 'teal',
        items: [
          'First tests for the match runtime: authorization, sequence idempotency, broadcast delivery, retention and rate limiting',
          'The multiplayer integration test now genuinely drives two WebSocket clients through one match, as its header always claimed',
          'Protocol parity tests assert the TypeScript and Go vocabularies are the same set, in both directions',
          'Server frame fixtures are compared against bytes the real handler writes, not against a map built inside the test',
        ],
      },
      {
        label: 'Correctness fixes',
        tone: 'teal',
        items: [
          'Leaving a match now returns your properties to the bank, as bankruptcy already did — previously they stayed owned by an eliminated player, unpurchasable and rent-free',
          'A retried action is answered without re-publishing its events, so a lost acknowledgement can no longer charge rent twice on every player',
          'The start bonus and doubles streak are bounded, closing an integer overflow that could drive a balance negative',
          'Ties in wealth victories are broken by seat as documented, and validation errors are reported in a deterministic order',
          'A failed join no longer leaves an unusable seat behind, and a corrupt snapshot is rejected instead of panicking mid-match',
        ],
      },
    ],
  },
  {
    version: '0.2.0',
    date: '2026-09-26',
    title: 'First table — the board loop',
    status: 'released',
    highlights: [
      {
        label: 'Playable board loop',
        tone: 'gold',
        items: [
          'A 24-space board as validated, canonical, hashed configuration data rather than hardcoded geometry',
          'Two-dice rolls, clockwise movement, start bonuses, and landing on owned property, tax or neutral space',
          'Buy or decline a property, pay rent to the owner, pay tax to the bank',
          'Doubles grant an extra roll up to a streak cap; the turn then passes',
          'No debt: a missed mandatory payment is an atomic bankruptcy, holdings return to the bank, and the turn moves on',
          'Victory by last player standing, target wealth, or a round limit',
        ],
      },
      {
        label: 'Server & client',
        tone: 'teal',
        items: [
          'Authoritative Go engine: pure, deterministic, and free of clock, I/O and randomness',
          'Private multiplayer matches over a versioned wire protocol with reconnect tokens stored only as hashes',
          'SolidJS client over a GPU-rendered PixiJS board that renders server state and computes no dice, rent or ownership itself',
        ],
      },
    ],
  },
  {
    version: '0.1.0',
    date: '2026-08-26',
    title: 'Foundation',
    status: 'in-development',
    highlights: [
      {
        label: 'Architecture',
        tone: 'gold',
        items: [
          'Bun monorepo: website (apps/web), game-client shell (apps/game), protocol and UI packages',
          'Go 1.26 modular-monolith backend with health/readiness/version surface and graceful shutdown',
          'Deterministic game-engine boundary: phases, players, actions, events, seeded RNG',
          'Shared client/server protocol with cross-language fixture tests (TypeScript ↔ Go)',
        ],
      },
      {
        label: 'Website & design',
        tone: 'teal',
        items: [
          'Full product site with responsive layouts and accessibility baseline',
          'Design system: felt-and-gold token set plus shared Solid primitives',
          'Interactive GameConfig preview validated against the real protocol schema',
        ],
      },
      {
        label: 'Tooling',
        tone: 'neutral',
        items: [
          'Validation pipeline: format, lint, typecheck, tests, builds, asset & repository sanity',
          'Browser verification via Playwright including axe accessibility scans',
          'CI (GitHub Actions), Docker packaging for the server, Cloudflare Pages deployment config',
          'PostgreSQL migrations infrastructure with explicit SQL files',
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="Changelog — HighJack"
  description="Every HighJack milestone, documented honestly: what shipped, what's next."
>
  <header class="max-w-3xl">
    <h1 class="m-0 font-display text-3xl font-extrabold sm:text-4xl">Changelog</h1>
    <p class="mt-4 mb-0 text-lg text-muted-400">
      We ship foundations before fireworks. Every milestone lands here.
    </p>
  </header>

  <div class="mt-10 flex max-w-3xl flex-col gap-6">
    {entries.map((entry) => (
      <article
        class="rounded-xl border border-line-subtle bg-surface-raised p-6 shadow-card sm:p-8"
        aria-labelledby={`release-${entry.version}`}
      >
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
          <h2 id={`release-${entry.version}`} class="m-0 font-display text-2xl font-extrabold">
            v{entry.version} — {entry.title}
          </h2>
          <Badge tone={entry.status === 'released' ? 'teal' : 'gold'}>
            {entry.status === 'released' ? 'Released' : 'In development'}
          </Badge>
          <time class="ml-auto font-mono text-xs text-muted-500" datetime={entry.date}>
            {entry.date}
          </time>
        </div>
        {entry.highlights.map((group) => (
          <section class="mt-5">
            <h3
              class={`m-0 font-mono text-xs uppercase tracking-widest ${group.tone === 'teal' ? 'text-teal-400' : group.tone === 'gold' ? 'text-gold-500' : 'text-muted-400'}`}
            >
              {group.label}
            </h3>
            <ul class="mt-2 mb-0 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted-400">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))}
      </article>
    ))}
  </div>
</BaseLayout>
