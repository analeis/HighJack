---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Badge } from '@highjack/ui';

interface Entry {
  version: string;
  date: string;
  title: string;
  status: 'released' | 'in-development';
  highlights: { label: string; tone: 'teal' | 'gold' | 'neutral'; items: string[] }[];
}

// Changelog entries, newest first. Keep in sync with git tags.
const entries: Entry[] = [
  {
    version: '0.2.11',
    date: '2026-10-21',
    title: 'Hygiene: the gate that could not run in CI',
    status: 'released',
    highlights: [
      {
        label: 'The release gate now runs everywhere it should',
        tone: 'gold',
        items: [
          'The previous release was certified locally and failed in CI, on the same commit, for the same check. CI pinned an older Bun than the typecheck gate needs, so the check it ran did not exist there',
          'The requirement is now stated once, as a minimum version, and the repository refuses a build that pins anything below it. Re-pinning the old version, lowering the requirement, or adding the old version pin back each fail the check',
          'CI installs the newest Bun rather than a fixed one, so a regression in the newest release surfaces immediately instead of at the next version bump',
        ],
      },
      {
        label: 'The commands do what they say',
        tone: 'teal',
        items: [
          'The root test command ran a shell loop into three directories by hand. It now uses the workspace filter, so a new workspace is picked up without editing anything',
          'The local test command was weaker than the release check it was meant to preview — no race detector, and a cached result could look like a pass. It is now the same',
          'Type checking has one command for all three checkers, and the format command has a check-only twin',
          'The website had a test command that ran nothing, and collecting the browser tests as if they were unit tests made a failure that had nothing to do with the code',
        ],
      },
      {
        label: 'Dependencies and infrastructure',
        tone: 'teal',
        items: [
          'Two version pins were removed as no-ops: the constraints that made them necessary no longer exist. The security floor they provided is now held by the dependency audit, which is one mechanism rather than two',
          'The pin that keeps the two browser-testing packages on one core version is kept, as a range so it still floats',
          'The database moved to PostgreSQL 18 and the image to a current Alpine, and the backend now sets up its own Go toolchain in the browser job instead of relying on the runner image',
          'An unreferenced script was removed, and five design documents that still said "v0.1.0 Foundation" were corrected',
        ],
      },
    ],
  },
  {
    version: '0.2.10',
    date: '2026-10-21',
    title: 'A leaner toolchain, and a website that is actually linted',
    status: 'released',
    highlights: [
      {
        label: 'Four tools became two, and one of them is Bun',
        tone: 'gold',
        items: [
          "Type checking now runs through Bun's own checker. It reads the same tsconfig, reports the same errors, needs no TypeScript package at all, and is about eighteen times faster",
          'The reference typechecker runs alongside it, and both must be clean. That is stronger than either alone: a mistake in one is caught by the other',
          'ESLint and Prettier are gone, replaced by oxlint and oxfmt — seventy-odd packages down to seven, and neither of them needs a TypeScript API',
          'The formatter configuration was migrated from the old Prettier config, so the reformat touched two files rather than the whole repository',
        ],
      },
      {
        label: 'The website is linted for the first time',
        tone: 'teal',
        items: [
          'Every Astro file was silently skipped by the old linter — it reported them as having "no matching configuration". The whole site, changelog and game page included, was formatted but never checked',
          'The new linter reads Astro frontmatter and understands the template, so an import used only in a template is not mistaken for an unused one',
        ],
      },
      {
        label: 'And the code itself',
        tone: 'teal',
        items: [
          'The retained event history no longer allocates on every action. Copying the window into a fresh slice cost about eleven kilobytes per action; copying it down in place costs none. The trim is about fifteen times faster and the memory is gone',
          "The game client's nine hundred-line component file is now seven focused modules, and the match runtime's thousand-line file is now a runtime, a registry and a rate limiter",
          'The Solid ref idiom is the same everywhere, so the assignment is visible in the source instead of being implied by a compiler transform',
          "A dead wrapper that the tests covered while production never called it is gone, and the lobby's cross-origin check now matches the socket's",
        ],
      },
    ],
  },
  {
    version: '0.2.9',
    date: '2026-10-01',
    title: 'A seat that is forgotten, and a pipeline that says what is wrong',
    status: 'released',
    highlights: [
      {
        label: 'A seat is released when it should be',
        tone: 'gold',
        items: [
          'The reconnect token is now stored per match rather than under one global key, so joining a second table no longer throws away the first',
          'A seat is dropped when its match ends, when the player leaves, and when the server says the match or the token is gone. The "forget" function existed and was called from nowhere, so a token that never expires and is never revoked sat in local storage for the life of the browser, and a reload kept returning the player to a table they had already left',
          'At most eight seats are kept, because every one of them is a bearer credential',
        ],
      },
      {
        label: 'The pipeline names its own problems',
        tone: 'teal',
        items: [
          'The lint gate now says "the root dependencies are not installed" instead of failing deep inside a linter with a module-not-found error that points at the wrong thing',
          'The certification pipeline itself is now linted. It produces the evidence for every other claim in this project, and it was type-checked but never linted — adding the coverage found an unused import on its first run',
          'The repository job no longer installs five hundred packages to run two scripts that import nothing but the standard library',
        ],
      },
      {
        label: 'The smaller ones',
        tone: 'neutral',
        items: [
          'A migration added late with a number below one already applied is now refused rather than silently skipped. The old watermark could not tell "already run" from "will never run", and the second leaves the schema behind the code',
          'The configuration package has tests for the first time',
          'Two dead parameters and a dead block are gone',
        ],
      },
    ],
  },
  {
    version: '0.2.8',
    date: '2026-09-30',
    title: 'The protocol contract now matches the wire',
    status: 'released',
    highlights: [
      {
        label: 'Two contracts that had quietly disagreed',
        tone: 'gold',
        items: [
          'The shared protocol required a "seed" field on a game-start event that the server deliberately never sends. The seed determines every future roll, so publishing it would let any participant predict the rest of the match — and the validator that checked incoming events rejected every game-start the server actually sent',
          'The server sends the list of spaces that reverted to the bank when a player goes bankrupt, and the contract did not describe the field at all, so a client reading the contract could not know it existed',
          'The client now reverts exactly the spaces the event names, rather than inferring it from ownership',
        ],
      },
      {
        label: 'Parity is now checked at the field level',
        tone: 'teal',
        items: [
          'The existing parity tests compare the names the two sides use. A new suite compares the shape of every event as it appears on the wire against the contract, by encoding a fully populated sample of each with the production encoder — so anything the encoder removes, and anything that can be omitted, is accounted for by construction',
          'The contract carries a compile-time assertion that it does not require a seed. If that field is ever added back, the build fails on the line that caused it',
          'The shared fixture for a game-start event no longer claims a field the wire does not have',
        ],
      },
    ],
  },
  {
    version: '0.2.7',
    date: '2026-09-29',
    title: 'A build that can say what it is',
    status: 'released',
    highlights: [
      {
        label: 'One version, everywhere, checked',
        tone: 'gold',
        items: [
          "The release version now lives in one file, VERSION, and everything that states a version reads it: the workspace manifests, the game client's build, the server binary, and the release tag",
          'The server binary is built with its version and commit linked in, so /version reports what is actually running. It used to report "dev" and "unknown" for every build, because no build path in the repository ever passed it a version at all — the container image even accepted the metadata as build arguments that nothing ever supplied',
          'The game client states its release in the top bar on every screen, not only a wide one. The badge was a literal, and it was two releases stale',
          'The container image and the browser-test server are both built the way the release builds them, so what the tests exercise is what ships',
        ],
      },
      {
        label: 'The versions cannot drift apart again',
        tone: 'teal',
        items: [
          'A repository check fails if the manifests, the client, or the release version disagree. It is a check rather than a convention, so the disagreement cannot come back',
          'The README described the project as a foundation "not yet the full game", four releases and a playable board loop ago',
        ],
      },
    ],
  },
  {
    version: '0.2.6',
    date: '2026-09-28',
    title: 'The lobby can no longer be exhausted',
    status: 'released',
    highlights: [
      {
        label: 'Nobody can lock the lobby out',
        tone: 'gold',
        items: [
          'Idle matches are now reclaimed. A match with no connected client that has not changed for an hour is evicted every minute, so the registry shrinks instead of only growing',
          'A match with a connected client is never evicted, however long it sits. A slow game, a player thinking, and a lobby waiting for a second player are all left alone',
          'The lobby is rate-limited per client address: 60 requests a minute by default, shared by match creation and seat claims. The WebSocket transport already limited actions; the HTTP surface did not, and it is the only one that creates durable state without a credential',
          'Both bounds were added together, because either alone was insufficient. The bound alone meant a script could fill the registry and keep it full forever; the sweep alone would have left it unbounded in principle',
        ],
      },
      {
        label: 'The documentation now says what the code does',
        tone: 'teal',
        items: [
          'The backend notes claimed the registry was "bounded and swept". It was bounded, and never swept. They also claimed the match lock being held across a database commit was fixed in v0.2.2. It was not, and it is still not — it is correct for a single instance, bounded at five seconds, and fixing it properly needs a design change rather than a patch',
          'The configuration package had no tests at all. It is the one place where a typo in an environment variable turns into a server that behaves differently from the one the operator intended',
        ],
      },
    ],
  },
  {
    version: '0.2.5',
    date: '2026-09-27',
    title: 'Correctness: a split transition, an honest refusal, and a flaky gate',
    status: 'released',
    highlights: [
      {
        label: 'A client is no longer handed half a transition',
        tone: 'gold',
        items: [
          "The retained event window is now trimmed on tick boundaries on every path, not only on the join path. Counting events cut a transition in half, because one transition emits several events that share a tick and the tick is the transition's identity on the wire",
          'A client resuming just below the oldest retained tick was served the tail of a split transition — a purchase without its payment, or a turn advance without the roll that caused it',
          'The defect was intermittent, because it depended on where the cut happened to land. It is now reproduced deterministically across pinned seeds, and the trim itself is tested directly',
        ],
      },
      {
        label: 'Refusals report what they are',
        tone: 'teal',
        items: [
          'A full match registry now answers 503 rather than 500. It is a capacity condition, not a server fault, and an operator reading the logs was being told the process was broken when it was working correctly and declining more work',
          'A custom board sent in a chunked request is now applied. The body was only read when the request declared a length, so every streaming client silently got the default board while the response reported success',
        ],
      },
      {
        label: 'The certification gate stopped failing at random',
        tone: 'teal',
        items: [
          'Two tests failed for reasons that had nothing to do with what they checked, and both were dependent on random values',
          'One asserted that a roll is never offered again, which is false when the dice are a double — a double grants an extra roll, and a double happens on one roll in six',
          'The other replaced the first character of a random hash with a fixed character, which is not a mutation at all when the hash already began with it — about one hash in sixteen',
          'Together these made roughly one certification run in five fail spuriously. A gate that fails at random is a gate whose green result means less than it appears to',
        ],
      },
    ],
  },
  {
    version: '0.2.4',
    date: '2026-09-26',
    title: 'Accessibility, and a CI pipeline that stopped lying',
    status: 'released',
    highlights: [
      {
        label: 'The board can be played without seeing it',
        tone: 'gold',
        items: [
          "The board is now described in words: phase, round, whose turn it is, the dice, every player's chips, position and state, and every space with its price, rent and owner — as real headings and tables, so a screen reader can navigate to the part it wants",
          'The canvas is hidden from assistive technology instead of announcing "HighJack board rendered from authoritative match state", which described the drawing method and nothing about the game',
          "Turn is marked by a ring on the active token, and ownership by the owner's initial on the space. Both were colour and animation only",
          'Under "reduce motion" the board now still shows whose turn it is. The turn indicator had been a pulse, and the animation code was disabled entirely for those users, so the game became unplayable rather than calmer',
        ],
      },
      {
        label: 'Reachable and announced',
        tone: 'teal',
        items: [
          'Turn, dice, readiness and connection changes are announced through a live region that is mounted once and never removed. The previous ones were mounted together with the message, which is why they announced nothing',
          'Focus moves to the board when a match starts, instead of being dropped on the document when the lobby unmounted',
          'Action buttons meet a 44px touch target, and the dock is a labelled group rather than a navigation landmark full of buttons',
        ],
      },
      {
        label: 'The pipeline now has to agree with itself',
        tone: 'teal',
        items: [
          'Backend CI runs the Go toolchain directly. Gating `go vet` and the race detector through a JavaScript runner meant the Go build depended on a runtime it never installed',
          'A repository check fails if any gate defined in the pipeline is not enforced by CI. That drift is not hypothetical: a `-run` filter once made a green step skip the tests it was named after',
          'Accessibility is now scanned on a live board on the real game origin, not only on a static lobby page',
        ],
      },
    ],
  },
  {
    version: '0.2.3',
    date: '2026-09-26',
    title: 'Client correctness and a playable experience',
    status: 'released',
    highlights: [
      {
        label: 'The client no longer decides the rules',
        tone: 'gold',
        items: [
          "The engine now computes which actions a player may take and sends it with every snapshot and every transition, so the interface renders the server's answer instead of re-deriving affordability, turn ownership and start eligibility",
          'A redundant ready toggle is refused rather than accepted as a silent no-op that still advanced the tick and still cost a write',
          'Decline stays available when a property is unaffordable. Gating it on affordability made a legal action unreachable and could strand a turn with every control dead',
          'The ready control is a real toggle, so a player who inherits the host role can withdraw',
        ],
      },
      {
        label: 'Playable',
        tone: 'teal',
        items: [
          'A dropped connection no longer wedges the table: the pending action is released, the buttons recover, and a click while offline says so instead of vanishing',
          'Players can join an existing table by match id, and a reload rejoins the same table instead of orphaning it',
          'A phone player can finally see their chips, whose turn it is, the round and their holdings. The information panel was hidden on small screens',
        ],
      },
      {
        label: 'Correct merge, real verification',
        tone: 'teal',
        items: [
          'An older snapshot can no longer rewind a newer view, and a re-delivered transition is applied once instead of charging rent twice',
          'The two-client browser test is now two real browser clients driving the real interface, replacing a raw WebSocket that never rendered a dock',
          'The browser harness never reuses an existing game server or preview. A leftover server from an earlier build was answering /health while running entirely different rules, which is how a broken release was certified twice',
        ],
      },
    ],
  },
  {
    version: '0.2.2',
    date: '2026-09-26',
    title: 'Multiplayer integrity and durability',
    status: 'released',
    highlights: [
      {
        label: 'Seats and authorization',
        tone: 'gold',
        items: [
          'Claiming a seat is refused on the socket. It previously minted a player with no reconnect token that could never be bound or removed, while consuming a seat — repeating it filled the match permanently',
          'A seat claim is now a real transition: state, events, snapshot and the player row commit in one transaction, and it is published to the table immediately',
          'A seat claim that cannot be committed consumes nothing, so an interrupted request no longer leaves a seat nothing can release',
        ],
      },
      {
        label: 'Delivery and recovery',
        tone: 'teal',
        items: [
          'A transition is delivered as one batched frame, so two transitions can no longer interleave on a single connection and leave a peer with the wrong turn and the wrong ownership',
          'A new connection receives nothing until its snapshot has been written, so it can never apply a transition the snapshot does not contain',
          'A commit that reports an error is reconciled against the stored state instead of being rolled back in memory. The old behaviour left memory a tick behind, and every later action then failed on a duplicate key, bricking the match',
          'Migrations are applied at boot and readiness checks the schema, so a server can no longer report itself ready against a database it cannot write to',
          'The server keeps idle connections alive, which it advertised but never did: an idle lobby or a long think used to be disconnected after 90 seconds',
        ],
      },
      {
        label: 'Hardening',
        tone: 'teal',
        items: [
          'Live matches and rate-limiter keys are both bounded and swept, closing an unauthenticated path to unbounded memory',
          'Outside development, an unconfigured origin allow-list now refuses browser origins instead of accepting any',
          'The match seed is no longer broadcast to clients; it stays in the durable event payload for replay',
          'Reconnect tokens are compared in constant time',
        ],
      },
    ],
  },
  {
    version: '0.2.1',
    date: '2026-09-26',
    title: 'Stabilization — evidence and engine correctness',
    status: 'released',
    highlights: [
      {
        label: 'Certification integrity',
        tone: 'gold',
        items: [
          'The certification report now identifies the tested tree, not just the last commit, and refuses to certify a dirty tree',
          'A skipped mandatory gate fails certification; optional gates are recorded as skipped, never as passed',
          'Dependency audit, Go vulnerability scan and the race detector are now certification gates, not CI-only steps',
          'CI invokes the same shared gate list instead of restating the commands, and the database gate no longer filters out the tests it exists to run',
        ],
      },
      {
        label: 'Verification coverage',
        tone: 'teal',
        items: [
          'First tests for the match runtime: authorization, sequence idempotency, broadcast delivery, retention and rate limiting',
          'The multiplayer integration test now genuinely drives two WebSocket clients through one match, as its header always claimed',
          'Protocol parity tests assert the TypeScript and Go vocabularies are the same set, in both directions',
          'Server frame fixtures are compared against bytes the real handler writes, not against a map built inside the test',
        ],
      },
      {
        label: 'Correctness fixes',
        tone: 'teal',
        items: [
          'Leaving a match now returns your properties to the bank, as bankruptcy already did — previously they stayed owned by an eliminated player, unpurchasable and rent-free',
          'A retried action is answered without re-publishing its events, so a lost acknowledgement can no longer charge rent twice on every player',
          'The start bonus and doubles streak are bounded, closing an integer overflow that could drive a balance negative',
          'Ties in wealth victories are broken by seat as documented, and validation errors are reported in a deterministic order',
          'A failed join no longer leaves an unusable seat behind, and a corrupt snapshot is rejected instead of panicking mid-match',
        ],
      },
    ],
  },
  {
    version: '0.2.0',
    date: '2026-09-26',
    title: 'First table — the board loop',
    status: 'released',
    highlights: [
      {
        label: 'Playable board loop',
        tone: 'gold',
        items: [
          'A 24-space board as validated, canonical, hashed configuration data rather than hardcoded geometry',
          'Two-dice rolls, clockwise movement, start bonuses, and landing on owned property, tax or neutral space',
          'Buy or decline a property, pay rent to the owner, pay tax to the bank',
          'Doubles grant an extra roll up to a streak cap; the turn then passes',
          'No debt: a missed mandatory payment is an atomic bankruptcy, holdings return to the bank, and the turn moves on',
          'Victory by last player standing, target wealth, or a round limit',
        ],
      },
      {
        label: 'Server & client',
        tone: 'teal',
        items: [
          'Authoritative Go engine: pure, deterministic, and free of clock, I/O and randomness',
          'Private multiplayer matches over a versioned wire protocol with reconnect tokens stored only as hashes',
          'SolidJS client over a GPU-rendered PixiJS board that renders server state and computes no dice, rent or ownership itself',
        ],
      },
    ],
  },
  {
    version: '0.1.0',
    date: '2026-08-26',
    title: 'Foundation',
    status: 'in-development',
    highlights: [
      {
        label: 'Architecture',
        tone: 'gold',
        items: [
          'Bun monorepo: website (apps/web), game-client shell (apps/game), protocol and UI packages',
          'Go 1.26 modular-monolith backend with health/readiness/version surface and graceful shutdown',
          'Deterministic game-engine boundary: phases, players, actions, events, seeded RNG',
          'Shared client/server protocol with cross-language fixture tests (TypeScript ↔ Go)',
        ],
      },
      {
        label: 'Website & design',
        tone: 'teal',
        items: [
          'Full product site with responsive layouts and accessibility baseline',
          'Design system: felt-and-gold token set plus shared Solid primitives',
          'Interactive GameConfig preview validated against the real protocol schema',
        ],
      },
      {
        label: 'Tooling',
        tone: 'neutral',
        items: [
          'Validation pipeline: format, lint, typecheck, tests, builds, asset & repository sanity',
          'Browser verification via Playwright including axe accessibility scans',
          'CI (GitHub Actions), Docker packaging for the server, Cloudflare Pages deployment config',
          'PostgreSQL migrations infrastructure with explicit SQL files',
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="Changelog — HighJack"
  description="Every HighJack milestone, documented honestly: what shipped, what's next."
>
  <header class="max-w-3xl">
    <h1 class="m-0 font-display text-3xl font-extrabold sm:text-4xl">Changelog</h1>
    <p class="mt-4 mb-0 text-lg text-muted-400">
      We ship foundations before fireworks. Every milestone lands here.
    </p>
  </header>

  <div class="mt-10 flex max-w-3xl flex-col gap-6">
    {entries.map((entry) => (
      <article
        class="rounded-xl border border-line-subtle bg-surface-raised p-6 shadow-card sm:p-8"
        aria-labelledby={`release-${entry.version}`}
      >
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
          <h2 id={`release-${entry.version}`} class="m-0 font-display text-2xl font-extrabold">
            v{entry.version} — {entry.title}
          </h2>
          <Badge tone={entry.status === 'released' ? 'teal' : 'gold'}>
            {entry.status === 'released' ? 'Released' : 'In development'}
          </Badge>
          <time class="ml-auto font-mono text-xs text-muted-500" datetime={entry.date}>
            {entry.date}
          </time>
        </div>
        {entry.highlights.map((group) => (
          <section class="mt-5">
            <h3
              class={`m-0 font-mono text-xs uppercase tracking-widest ${group.tone === 'teal' ? 'text-teal-400' : group.tone === 'gold' ? 'text-gold-500' : 'text-muted-400'}`}
            >
              {group.label}
            </h3>
            <ul class="mt-2 mb-0 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted-400">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))}
      </article>
    ))}
  </div>
</BaseLayout>
