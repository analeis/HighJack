---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemCard from '../components/SystemCard.astro';
import { Badge } from '@highjack/ui';
import { SYSTEMS } from '../data/systems';
---

<BaseLayout
  title="HighJack — a multiplayer board game"
  description="Roll, buy properties and collect rent in a private match. One authoritative server decides every outcome."
>
  <section class="border-b border-line-subtle" aria-labelledby="hero-title">
    <div
      class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 md:grid-cols-[1.15fr_0.85fr] md:items-center md:py-24"
    >
      <div>
        <p class="m-0 font-mono text-xs uppercase tracking-widest text-gold-500">
          v0.2 · Playable board loop
        </p>
        <h1
          id="hero-title"
          class="mb-0 mt-4 font-display text-4xl leading-[1.08] text-cream-100 sm:text-5xl lg:text-6xl"
        >
          A board game without disputed rolls
        </h1>
        <p class="mb-0 mt-6 max-w-xl text-lg leading-relaxed text-muted-400">
          HighJack puts dice, property and rent on one authoritative server. Create a private
          match, share the id, and take turns in your browser. Every outcome is decided once, for
          everyone at the table.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/game"
            class="rounded-md bg-gold-500 px-6 py-3 text-sm font-semibold text-felt-950 no-underline transition-colors hover:bg-gold-400"
          >
            See what you can play
          </a>
          <a
            href="/rules"
            class="rounded-md border border-line-strong px-6 py-3 text-sm font-semibold text-cream-100 no-underline transition-colors hover:border-cream-300"
          >
            Read the rules
          </a>
        </div>
      </div>

      {/* A quiet board motif. Pure CSS, and hidden from assistive technology. */}
      <div class="hidden md:block" aria-hidden="true">
        <div class="grid grid-cols-4 gap-2 opacity-80">
          {
            Array.from({ length: 16 }, (_, i) => (
              <div
                class:list={[
                  'aspect-square rounded-sm border border-line-subtle',
                  i === 5 || i === 10 ? 'bg-gold-500/15' : 'bg-felt-800',
                ]}
              >
                <div class="flex h-full items-center justify-center">
                  <div
                    class:list={[
                      'h-2 w-2 rounded-full',
                      i === 5 ? 'bg-gold-500' : i === 10 ? 'bg-cream-300' : 'bg-felt-600',
                    ]}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-line-subtle" aria-label="Match facts">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-5 py-10 sm:px-8 md:grid-cols-4">
      <div>
        <p class="m-0 font-display text-4xl text-cream-100">2–8</p>
        <p class="mb-0 mt-1 text-sm text-muted-400">players per private table</p>
      </div>
      <div>
        <p class="m-0 font-display text-4xl text-cream-100">1</p>
        <p class="mb-0 mt-1 text-sm text-muted-400">server decides every outcome</p>
      </div>
      <div>
        <p class="m-0 font-display text-4xl text-cream-100">3</p>
        <p class="mb-0 mt-1 text-sm text-muted-400">ways to win a match</p>
      </div>
      <div>
        <p class="m-0 font-display text-4xl text-cream-100">0</p>
        <p class="mb-0 mt-1 text-sm text-muted-400">accounts required to play</p>
      </div>
    </div>
  </section>

  <section class="border-b border-line-subtle py-16" aria-labelledby="today-title">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <h2 id="today-title" class="m-0 font-display text-2xl text-cream-100 sm:text-3xl">
        What works today
      </h2>
      <p class="mb-0 mt-4 max-w-3xl text-base leading-relaxed text-muted-400">
        The current release covers rolling, movement, buying, rent, tax, bankruptcy and
        last-player-standing victory. Trading, auctions and casino tables are designed but not
        built. The
        <a
          class="text-gold-400 underline underline-offset-2 hover:text-gold-300"
          href="/features">features page</a
        >
        marks each system with its real status.
      </p>
    </div>
  </section>

  <section class="border-b border-line-subtle py-16" aria-labelledby="how-title">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <h2 id="how-title" class="m-0 font-display text-2xl text-cream-100 sm:text-3xl">
        How the game works
      </h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3 md:gap-10">
        <div>
          <h3 class="m-0 font-display text-lg font-semibold text-cream-100">One referee</h3>
          <p class="mb-0 mt-3 text-sm leading-relaxed text-muted-400">
            The server rolls the dice, applies purchases and charges rent. The browser draws the
            result and sends your choices. Nobody can edit their own balance.
          </p>
        </div>
        <div>
          <h3 class="m-0 font-display text-lg font-semibold text-cream-100">Private tables</h3>
          <p class="mb-0 mt-3 text-sm leading-relaxed text-muted-400">
            Create a match, copy its id and share it with the people you want to play with. There
            is no account and no public matchmaking.
          </p>
        </div>
        <div>
          <h3 class="m-0 font-display text-lg font-semibold text-cream-100">Replayable</h3>
          <p class="mb-0 mt-3 text-sm leading-relaxed text-muted-400">
            Rolls come from a seeded stream. The same seed and the same actions produce the same
            match, so any result can be checked afterwards.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16" aria-labelledby="systems-title">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="systems-title" class="m-0 font-display text-2xl text-cream-100 sm:text-3xl">
            Systems in the catalog
          </h2>
          <p class="mb-0 mt-3 max-w-2xl text-sm leading-relaxed text-muted-400">
            Property and economy is playable. The rest are modelled or planned, and each tile says
            which.
          </p>
        </div>
        <a href="/features" class="text-sm font-semibold text-gold-400 no-underline hover:text-gold-300">
          All systems →
        </a>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {SYSTEMS.slice(0, 6).map((system) => <SystemCard system={system} />)}
      </div>
      <p class="mb-0 mt-8 text-xs text-muted-500">
        <Badge tone="neutral">Status</Badge> Playable · Modeled · In development · Planned
      </p>
    </div>
  </section>
</BaseLayout>
